{
 "source": "01_AUDIO/Original/NeuralLink chip vid 2.m4a.mp4",
 "decoded_duration_s": 71.168,
 "subtitle_chunks": [
  {
   "start": 0.05,
   "end": 1.22,
   "text": "أقول لك كيف رح تبطّل",
   "emphasis": []
  },
  {
   "start": 1.24,
   "end": 2.46,
   "text": "تنسى أي إشي بحياتك؟",
   "emphasis": [
    "تنسى"
   ]
  },
  {
   "start": 2.52,
   "end": 3.92,
   "text": "أول إشي، رح نركّب",
   "emphasis": []
  },
  {
   "start": 3.94,
   "end": 4.98,
   "text": "شريحة صغيرة بمخّك",
   "emphasis": [
    "شريحة"
   ]
  },
  {
   "start": 5.0,
   "end": 6.62,
   "text": "ونوصّلها بالخلايا العصبية",
   "emphasis": [
    "العصبية"
   ]
  },
  {
   "start": 6.64,
   "end": 7.94,
   "text": "بخيوط أدقّ من الشعرة",
   "emphasis": [
    "أدقّ"
   ]
  },
  {
   "start": 8.36,
   "end": 9.4,
   "text": "لمّا تفكّر،",
   "emphasis": [
    "تفكّر،"
   ]
  },
  {
   "start": 9.79,
   "end": 11.33,
   "text": "مخّك بيطلّع إشارات كهربائية",
   "emphasis": [
    "كهربائية"
   ]
  },
  {
   "start": 11.36,
   "end": 12.5,
   "text": "الشريحة بتقرأها،",
   "emphasis": [
    "بتقرأها،"
   ]
  },
  {
   "start": 12.52,
   "end": 14.4,
   "text": "والذكاء الاصطناعي بيترجمها لمعلومات",
   "emphasis": [
    "بيترجمها"
   ]
  },
  {
   "start": 14.42,
   "end": 16.15,
   "text": "وبالمستقبل بيقدر كمان",
   "emphasis": [
    "وبالمستقبل"
   ]
  },
  {
   "start": 16.18,
   "end": 17.38,
   "text": "يرجّع معلومات لمخّك",
   "emphasis": [
    "يرجّع"
   ]
  },
  {
   "start": 17.81,
   "end": 19.62,
   "text": "هسّا تخيّل كل إشي بتشوفه،",
   "emphasis": [
    "تخيّل"
   ]
  },
  {
   "start": 19.64,
   "end": 20.45,
   "text": "بتسمعه،",
   "emphasis": [
    "بتسمعه،"
   ]
  },
  {
   "start": 20.5,
   "end": 21.56,
   "text": "أو حتى بتفكّر فيه،",
   "emphasis": [
    "بتفكّر"
   ]
  },
  {
   "start": 21.58,
   "end": 22.5,
   "text": "بنحوّله لبيانات",
   "emphasis": [
    "لبيانات"
   ]
  },
  {
   "start": 22.52,
   "end": 23.96,
   "text": "وبنعمله باك أب على الكلاود",
   "emphasis": [
    "الكلاود"
   ]
  },
  {
   "start": 24.33,
   "end": 25.54,
   "text": "مثلاً بعد سبع سنين",
   "emphasis": [
    "سبع"
   ]
  },
  {
   "start": 25.56,
   "end": 26.8,
   "text": "بتسمع عن هاي التقنية",
   "emphasis": []
  },
  {
   "start": 26.82,
   "end": 27.6,
   "text": "وبتحكي: لحظة!",
   "emphasis": [
    "لحظة!"
   ]
  },
  {
   "start": 27.62,
   "end": 28.92,
   "text": "أنا سامع عنها من قبل،",
   "emphasis": []
  },
  {
   "start": 28.94,
   "end": 29.7,
   "text": "بس مين حكالي؟",
   "emphasis": [
    "مين"
   ]
  },
  {
   "start": 29.72,
   "end": 31.6,
   "text": "الشريحة بتفتّش بذكرياتك",
   "emphasis": [
    "بذكرياتك"
   ]
  },
  {
   "start": 31.62,
   "end": 32.88,
   "text": "وبترجعلك الجواب فوراً",
   "emphasis": [
    "فوراً"
   ]
  },
  {
   "start": 32.9,
   "end": 33.7,
   "text": "آه والله! قائد",
   "emphasis": [
    "والله!"
   ]
  },
  {
   "start": 33.72,
   "end": 34.96,
   "text": "اللي حكالي عن هاي التقنية",
   "emphasis": []
  },
  {
   "start": 34.98,
   "end": 35.68,
   "text": "بهذا الفيديو",
   "emphasis": [
    "الفيديو"
   ]
  },
  {
   "start": 36.0,
   "end": 36.96,
   "text": "والأقوى من هيك،",
   "emphasis": [
    "والأقوى"
   ]
  },
  {
   "start": 37.36,
   "end": 38.8,
   "text": "ممكن ناخد ذكرياتك كلها",
   "emphasis": [
    "ذكرياتك"
   ]
  },
  {
   "start": 38.82,
   "end": 39.78,
   "text": "ونحطّها بروبوت،",
   "emphasis": [
    "بروبوت،"
   ]
  },
  {
   "start": 39.8,
   "end": 40.8,
   "text": "أو حتى بجسم تاني",
   "emphasis": [
    "بجسم"
   ]
  },
  {
   "start": 41.18,
   "end": 42.76,
   "text": "يعني باختصار، بنعملّك استنساخ",
   "emphasis": [
    "استنساخ"
   ]
  },
  {
   "start": 42.78,
   "end": 43.5,
   "text": "لا، بمزح!",
   "emphasis": [
    "بمزح!"
   ]
  },
  {
   "start": 43.52,
   "end": 44.34,
   "text": "مش بهاي البساطة",
   "emphasis": []
  },
  {
   "start": 44.36,
   "end": 45.48,
   "text": "نسخ ذكرياتك إشي،",
   "emphasis": [
    "نسخ"
   ]
  },
  {
   "start": 45.5,
   "end": 46.86,
   "text": "ونقل وعيك إشي تاني",
   "emphasis": [
    "وعيك"
   ]
  },
  {
   "start": 46.88,
   "end": 48.58,
   "text": "طب هسّا، الجد: وين وصلنا فعلياً؟",
   "emphasis": [
    "فعلياً؟"
   ]
  },
  {
   "start": 48.7,
   "end": 50.7,
   "text": "شركة نيورالينك تبعت إيلون ماسك",
   "emphasis": [
    "نيورالينك"
   ]
  },
  {
   "start": 50.72,
   "end": 52.06,
   "text": "قدرت تخلّي أشخاص",
   "emphasis": []
  },
  {
   "start": 52.08,
   "end": 54.25,
   "text": "يتحكّموا بالكمبيوتر بإشارات مخّهم",
   "emphasis": [
    "بإشارات"
   ]
  },
  {
   "start": 54.3,
   "end": 55.88,
   "text": "يعني صرنا نقدر نتحكّم",
   "emphasis": []
  },
  {
   "start": 55.9,
   "end": 57.16,
   "text": "بأشياء على الكمبيوتر",
   "emphasis": []
  },
  {
   "start": 57.18,
   "end": 58.36,
   "text": "بمجرّد التفكير",
   "emphasis": [
    "التفكير"
   ]
  },
  {
   "start": 58.38,
   "end": 59.8,
   "text": "وهذا إشي حقيقي وصار فعلاً",
   "emphasis": [
    "حقيقي"
   ]
  },
  {
   "start": 60.29,
   "end": 61.54,
   "text": "أمّا حفظ ذكرياتك كلها،",
   "emphasis": [
    "حفظ"
   ]
  },
  {
   "start": 61.56,
   "end": 62.94,
   "text": "فهذا المستقبل اللي بحكي عنه",
   "emphasis": [
    "المستقبل"
   ]
  },
  {
   "start": 62.96,
   "end": 64.22,
   "text": "بس أهم إشي: لا تنسى",
   "emphasis": []
  },
  {
   "start": 64.24,
   "end": 65.36,
   "text": "تدفع الاشتراك للكلاود",
   "emphasis": [
    "الاشتراك"
   ]
  },
  {
   "start": 65.38,
   "end": 66.52,
   "text": "بلاش تتعبّى الميموري",
   "emphasis": [
    "الميموري"
   ]
  },
  {
   "start": 66.56,
   "end": 67.92,
   "text": "وهذا تاني فيديو إلي",
   "emphasis": []
  },
  {
   "start": 67.94,
   "end": 68.96,
   "text": "تابعني لأنك رح تسمع",
   "emphasis": [
    "تابعني"
   ]
  },
  {
   "start": 68.98,
   "end": 71.1,
   "text": "أشياء مش رح تسمعها بمكان تاني",
   "emphasis": []
  }
 ],
