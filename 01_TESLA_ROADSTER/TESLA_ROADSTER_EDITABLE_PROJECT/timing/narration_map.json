 "_about": "Sentence/phrase-level timing anchors for the immutable narration master (voiceover_ORIGINAL.m4a, 79.11 s). Times come from local Whisper-small word alignment (cross-attention DTW) on a 16 kHz analysis copy, checked against silencedetect pauses. Text is the ASR output corrected by hand to Jordanian Arabic; entries with 'verify' contain words the ASR could not resolve clearly and must be confirmed by the speaker.",
 "cues": [
  {"id": 1,  "start": 0.00,  "end": 1.50,  "text": "وانا شفنا تسلا رودستر الجديدة"},
  {"id": 2,  "start": 1.52,  "end": 2.92,  "text": "طلعت على الحيط وقلبت حالها"},
  {"id": 3,  "start": 2.94,  "end": 4.28,  "text": "وحتى نطّت فوق السيارات"},
  {"id": 4,  "start": 4.32,  "end": 5.80,  "text": "بس كيف؟ أنا رح أشرحلكم"},
  {"id": 5,  "start": 5.84,  "end": 7.28,  "text": "أول إشي، كيف ظلّت ماسكة بالحيط؟"},
  {"id": 6,  "start": 7.32,  "end": 9.36,  "text": "تحت السيارة أربع مراوح شفط قوية"},
  {"id": 7,  "start": 9.40,  "end": 11.28, "text": "بتسحب الهوا، فبيقلّ الضغط تحتها"},
  {"id": 8,  "start": 11.34, "end": 13.30, "text": "والضغط الأعلى من برّا بيدفعها باتجاه السطح"},
  {"id": 9,  "start": 13.41, "end": 15.43, "text": "تخيّل مكنسة كهربا ماسكة بسجادة"},
  {"id": 10, "start": 15.47, "end": 18.05, "text": "نفس المبدأ، بس بقوة بتكفّي سيارة كاملة"},
  {"id": 11, "start": 18.21, "end": 19.88, "text": "طب كيف بتنطّ وبتتنقّل بالهوا؟", "verify": "بتتنقّل (ASR: تنجل)"},
  {"id": 12, "start": 19.95, "end": 22.40, "text": "هون في دافعات بتطلق غاز مضغوط بقوة هائلة"},
  {"id": 13, "start": 22.45, "end": 24.98, "text": "فبتقدر تدفع السيارة وتغيّر اتجاهها بالهوا"},
  {"id": 14, "start": 25.06, "end": 28.20, "text": "وهاي نفس فكرة دافعات التحكم المستخدمة بالمركبات الفضائية"},
  {"id": 15, "start": 28.30, "end": 29.95, "text": "وأصلًا تطويرها بالتعاون مع SpaceX"},
  {"id": 16, "start": 30.00, "end": 31.45, "text": "طيب شو الفايدة غير الاستعراض؟"},
  {"id": 17, "start": 31.52, "end": 33.15, "text": "الشفط بزيد تماسك السيارة بالأرض"},
  {"id": 18, "start": 33.20, "end": 35.30, "text": "وبخلّيها تاخد منعطفات بسرعات جنونية"},
  {"id": 19, "start": 35.42, "end": 37.02, "text": "والدافعات بتعطيها تسارع أقوى"},
  {"id": 20, "start": 37.08, "end": 40.30, "text": "وبحسب تسلا، بتوصل من صفر لـ٩٦ كيلومتر بالساعة"},
  {"id": 21, "start": 40.34, "end": 41.48, "text": "بأقل من ثانية"},
  {"id": 22, "start": 41.56, "end": 44.40, "text": "وكمان بتساعدها تتحكم بحركتها وتوازنها بالهوا"},
  {"id": 23, "start": 44.58, "end": 45.72, "text": "طب هل نقدر نشتريها؟"},
  {"id": 24, "start": 45.80, "end": 46.48, "text": "في تلات فئات:"},
  {"id": 25, "start": 46.52, "end": 49.38, "text": "نظام شفط بدون دافعات ومقعدين، اسمها Performance"},
  {"id": 26, "start": 49.42, "end": 52.70, "text": "والتانية Thrust، مع دافعات خلفية لتسارع أقوى ومقعدين"},
  {"id": 27, "start": 52.78, "end": 55.40, "text": "وRocket، فيها عشر دافعات للقفز والتحكم بالهوا"},
  {"id": 28, "start": 55.46, "end": 57.38, "text": "ومقعد واحد، وهي بالدعوات فقط"},
  {"id": 29, "start": 57.46, "end": 60.50, "text": "والحجز من موقع تسلا الرسمي: بتدفع أول إشي ٥ تلاف دولار"},
  {"id": 30, "start": 60.56, "end": 63.15, "text": "وخلال ١٠ أيام بتكمّل المبلغ لـ٥٠ ألف دولار"},
  {"id": 31, "start": 63.22, "end": 64.28, "text": "لفئة Performance"},
  {"id": 32, "start": 64.32, "end": 66.36, "text": "أو ٢٥٠ ألف دولار لفئة Thrust"},
  {"id": 33, "start": 66.44, "end": 68.90, "text": "وهاي مبالغ حجز، مش أسعار السيارات النهائية"},
  {"id": 34, "start": 68.96, "end": 71.20, "text": "والإنتاج مستهدف في بداية ٢٠٢٨", "verify": "بداية (ASR: بداقب)"},
  {"id": 35, "start": 71.32, "end": 73.94, "text": "إذا اليوم سيارة بتقدر تنطّ وتتحكم بحركتها بالهوا"},
  {"id": 36, "start": 73.98, "end": 75.70, "text": "شو ممكن نشوف بالسنين الجاي؟", "verify": "one short word at 73.98-74.20 not resolved (ASR: خلالوا); omitted from subtitle until confirmed"},
  {"id": 37, "start": 75.80, "end": 76.45, "text": "هذا أول فيديو إلي"},
  {"id": 38, "start": 76.48, "end": 79.00, "text": "تابعوني لحتى تشوفوا أشياء ما رح تشوفوها بمكان تاني"}
 ],
